{
  "version": 3,
  "action_sets": [
    { "name": "/actions/translator", "usage": "leftright" }
  ],
  "actions": [
    { "name": "/actions/translator/in/translate", "type": "boolean", "requirement": "suggested" },
    { "name": "/actions/translator/in/nextpage", "type": "boolean", "requirement": "optional" },
    { "name": "/actions/translator/in/leftpointer", "type": "pose", "requirement": "optional" },
    { "name": "/actions/translator/in/rightpointer", "type": "pose", "requirement": "optional" }
  ],
  "default_bindings": [
    { "controller_type": "oculus_touch", "binding_url": "bindings_oculus_touch.json" },
    { "controller_type": "knuckles", "binding_url": "bindings_knuckles.json" },
    { "controller_type": "vive_controller", "binding_url": "bindings_vive_controller.json" }
  ],
  "localization": [
    {
      "language_tag": "en_US",
      "/actions/translator": "Mugonzei Honyakuki",
      "/actions/translator/in/translate": "Hold to select a rectangle, or hold 1.5 seconds for full view",
      "/actions/translator/in/nextpage": "Next translation page",
      "/actions/translator/in/leftpointer": "Left controller pointer for rectangle selection",
      "/actions/translator/in/rightpointer": "Right controller pointer for rectangle selection"
    },
    {
      "language_tag": "zh_CN",
      "/actions/translator": "无言势翻译器",
      "/actions/translator/in/translate": "按住框选；全画面模式长按 1.5 秒截图",
      "/actions/translator/in/nextpage": "下一页译文",
      "/actions/translator/in/leftpointer": "框选区域：左手柄指向",
      "/actions/translator/in/rightpointer": "框选区域：右手柄指向"
    }
  ]
}
