<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>SteamVrTranslator</AssemblyName>
    <Version>0.2.6-preview</Version>
    <Product>无言势翻译器 · Mugonzei Honyakuki</Product>
    <Description>SteamVR screenshot, handwriting recognition and translation overlay.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets/mugonzei.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <Compile Include="vendor/openvr_api.cs" Nullable="disable" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <Content Include="vendor/openvr_api.dll" Link="openvr_api.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets/**/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="tessdata/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="vendor/*LICENSE*" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="tools/local-ocr-runtime/**/*"
             Exclude="tools/local-ocr-runtime/**/__pycache__/**;tools/local-ocr-runtime/**/*.pyc;tools/local-ocr-runtime/local-japanese-ocr-worker.py"
             Link="local-ocr-runtime/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="tools/local-japanese-ocr-worker.py" Link="local-ocr-runtime/local-japanese-ocr-worker.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
