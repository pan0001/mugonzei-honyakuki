<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.2.8-preview</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../shared/GameTextFilter.cs" Link="Shared/GameTextFilter.cs" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Override the 2.1.11 native dependency (CVE-2025-6965); keep the requested managed provider version. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <Content Include="licenses/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="README.md;configuration.example.txt" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ADMIN.md;COUPONS.md" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="../website/admin/index.html;../website/admin/admin.css;../website/admin/admin.js;../website/admin/accounts.js"
                      LogicalName="Mugonzei.Admin.%(Filename)%(Extension)" />
    <Content Include="deploy/README.md;deploy/mugonzei.service;deploy/server.env.example;deploy/build-sqlite-linux.py;deploy/Caddyfile.example;deploy/caddy.service" CopyToPublishDirectory="PreserveNewest" />
    <Compile Remove="tests/**/*.cs" />
    <Content Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>
</Project>
