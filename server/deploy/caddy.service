[Unit]
Description=Caddy HTTPS reverse proxy for Mugonzei
Documentation=https://caddyserver.com/docs/
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
User=caddy
Group=caddy
ExecStart=/opt/mugonzei/caddy/caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
ExecReload=/opt/mugonzei/caddy/caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile --force
Environment=XDG_DATA_HOME=/var/lib/caddy/.local/share
Environment=XDG_CONFIG_HOME=/var/lib/caddy/.config
StateDirectory=caddy
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
LimitNOFILE=65536
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/caddy
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
