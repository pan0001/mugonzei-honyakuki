# systemd EnvironmentFile template, not a shell script. No real accounts or keys.
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5187
MUGONZEI_DATABASE=/var/lib/mugonzei/mugonzei.db
MUGONZEI_TRUSTED_PROXIES=
MUGONZEI_LIVE_PAYMENTS=false
MUGONZEI_MOCK_PAYMENTS=false
MUGONZEI_PLANS_JSON=[]
AFDIAN_USER_ID=
AFDIAN_TOKEN=
AFDIAN_PAYMENT_BASE_URL=
Translation__BaseUrl=
Translation__ApiKey=
Translation__Model=
Translation__TimeoutSeconds=120
Translation__Concurrency=1
Translation__QueueCapacity=4
Translation__Mock=false
# Registration mail: empty values disable new registration; existing accounts can sign in.
# Explicit STARTTLS only; use the submission port supported by your provider (not implicit TLS 465).
MUGONZEI_SMTP_HOST=
MUGONZEI_SMTP_PORT=587
MUGONZEI_SMTP_FROM=
MUGONZEI_SMTP_USERNAME=
MUGONZEI_SMTP_PASSWORD=
# Independent random 32-byte key in Base64; keep it in private server configuration.
MUGONZEI_EMAIL_CODE_KEY=
MUGONZEI_EMAIL_DAILY_LIMIT=200
